# Nicht aktivierte User-Unit-Vorlage für das gemeinsam geprüfte C9-Release.
# @RELEASE_ROOT@ vor dem Gruppengate an den vollständigen Source-SHA binden.
[Unit]
Description=Deadlock Brain integrated Rust API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@RELEASE_ROOT@
LoadCredential=infisical-token:%h/.config/infisical-tokens/infisical-token-bots
# brain.infisical.credential_fd=5 bindet das tatsächlich geöffnete systemd-Credential.
# %d bezeichnet dessen Verzeichnis; die gemeinsame Bot-TOML enthält keine Secretwerte.
ExecStart=/bin/bash -c 'exec 5<"%d/infisical-token"; exec @RELEASE_ROOT@/brain-serve --config @RELEASE_ROOT@/config/bot.toml'
KillSignal=SIGTERM
KillMode=control-group
# Die Dienstgrenze liegt oberhalb des validierten Shutdownbudgets.
TimeoutStopSec=70
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
# Preserve host root's UID mapping for the existing Infisical Unix transport,
# which requires socket ownership by UID 0. User-unit mount sandboxes can remap it.
PrivateUsers=no
PrivateTmp=no
PrivateDevices=no
ProtectSystem=no
ProtectHome=no
ProtectKernelTunables=no
ProtectControlGroups=no
ProtectProc=default
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
