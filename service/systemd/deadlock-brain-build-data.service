[Unit]
Description=Deadlock Brain build data refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/naniadm/Documents/Deadlock-Brain
LoadCredential=infisical-token:/home/naniadm/.config/infisical-tokens/infisical-token-bots
ExecStart=/home/naniadm/Documents/Deadlock-Brain/scripts/run_build_data_with_infisical.sh

[Install]
WantedBy=default.target
