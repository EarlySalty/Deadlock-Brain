[Unit]
Description=Deadlock-Spielwerte (/brain, loopback 8087)
After=network.target

[Service]
Type=exec
User=nathanael
Group=nathanael
LoadCredential=infisical-token:/home/nathanael/.config/infisical-tokens/infisical-token-bots
ExecStart=/opt/deadlock-brain/current/bin/deadlock-brain-site --pg-config /home/nathanael/.config/deadlock-brain/site-peer.json
MemoryAccounting=yes
MemoryMax=256M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
