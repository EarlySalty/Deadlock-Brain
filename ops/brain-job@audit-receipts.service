[Unit]
Description=Deadlock Brain receipt audit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Slice=system.slice
User=nathanael
Group=nathanael
WorkingDirectory=/opt/deadlock-brain/current
ExecStart=/opt/deadlock-brain/current/bin/brain-job audit-receipts --config /etc/deadlock-brain/brain-job.json
ExecStartPost=/usr/bin/cat /sys/fs/cgroup/memory/system.slice/brain-job@audit-receipts.service/memory.limit_in_bytes /sys/fs/cgroup/memory/system.slice/brain-job@audit-receipts.service/memory.max_usage_in_bytes
TimeoutStartSec=115s
TimeoutStopSec=5s
Restart=no
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
MemoryAccounting=yes
MemoryMax=512M
MemorySwapMax=0
