[Unit]
Description=Eigener Codex-Abo-Proxy für Deadlock Brain
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/nathanael
ExecStart=/home/nathanael/.local/bin/claude-code-proxy serve --port 18769 --no-monitor
UnsetEnvironment=CCP_ALIAS_PROVIDER CCP_AUTO_REVIEW_MODEL CCP_BIND_ADDRESS CCP_CODEX_BASE_URL CCP_CODEX_EFFORT CCP_CODEX_HEADER_TIMEOUT_MS CCP_CODEX_IMAGES_API CCP_CODEX_IMAGES_BASE_URL CCP_CODEX_MODEL CCP_CODEX_ORIGINATOR CCP_CODEX_PREVIOUS_RESPONSE_ID CCP_CODEX_REASONING_SUMMARY CCP_CODEX_RESPONSES_API CCP_CODEX_SERVER_COMPACTION CCP_CODEX_SERVICE_TIER CCP_CODEX_TRANSCRIPTIONS_API CCP_CODEX_TRANSPORT CCP_CODEX_USER_AGENT CCP_COMPACT_EFFORT CCP_CONFIG_DIR CCP_CURSOR_AGENT_BUNDLE CCP_CURSOR_AUTH_TOKEN CCP_CURSOR_BASE_URL CCP_CURSOR_CLIENT_VERSION CCP_GROK_BASE_URL CCP_GROK_CLIENT_VERSION CCP_GROK_HOSTED_SEARCH CCP_GROK_SEARCH_BLOCKS CCP_GROK_TOOL_IMAGE CCP_KIMI_BASE_URL CCP_KIMI_OAUTH_HOST CCP_KIMI_USER_AGENT CCP_LOG_STDERR CCP_LOG_VERBOSE CCP_OPENCODE_API_KEY CCP_OPENCODE_BASE_URL CCP_TRAFFIC_LOG CCP_USER_AGENT CLAUDE_CODE_PROXY_CODEX_BASE_URL OPENCODE_API_KEY PORT XDG_CONFIG_HOME XDG_STATE_HOME HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=default.target
