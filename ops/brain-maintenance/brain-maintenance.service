[Unit]
Description=Deadlock-Brain-Dokumentation prüfen und freigegebene Fassungen übernehmen

[Service]
Type=oneshot
LoadCredential=infisical-token:%h/.config/infisical-tokens/infisical-token-bots
ExecStart=/bin/bash -c 'exec 5<"%d/infisical-token"; exec @RELEASE_ROOT@/brain-maintain --config @RELEASE_ROOT@/config/bot.toml tick'
TimeoutStartSec=40min
KillMode=control-group
UMask=0077
NoNewPrivileges=true
# Mount-Sandboxing bei User-Units verändert die für Infisical geprüfte Host-Identität.
PrivateUsers=false
PrivateTmp=false
ProtectSystem=false
ProtectProc=default
