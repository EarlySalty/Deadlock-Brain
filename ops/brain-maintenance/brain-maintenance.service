[Unit]
Description=Deaktivierte bisherige Deadlock-Brain-Dokumentpflege
ConditionPathExists=/dev/null/brain-maintenance-retired

[Service]
Type=oneshot
MemoryAccounting=yes
MemoryMax=512M
LoadCredential=infisical-token:%h/.config/infisical-tokens/infisical-token-bots
ExecStart=/opt/deadlock-brain/current/bin/brain-maintain --config /etc/deadlock-brain/maintenance-runtime.json tick
TimeoutStartSec=120min
KillMode=control-group
UMask=0077
NoNewPrivileges=true
# Mount-Sandboxing bei User-Units verändert die für Infisical geprüfte Host-Identität.
PrivateUsers=false
PrivateTmp=false
ProtectSystem=false
ProtectProc=default
