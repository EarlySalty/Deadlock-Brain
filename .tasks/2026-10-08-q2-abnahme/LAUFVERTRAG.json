{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Q2: lokaler Laufvertrag, kein ausgeführter Lauf",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "set_sha256", "source_hashes", "fixed_layer_sha256", "provider", "code_shas", "knowledge_binding", "live_prerequisite_evidence_sha256", "samples"],
  "properties": {
    "schema": {"const": "brain.q2.private-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "set_sha256": {"$ref": "#/$defs/digest"},
    "source_hashes": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "fixed_layer_sha256": {"$ref": "#/$defs/digest", "description": "Gemeinsame Bindung für Rechte, Werkzeuge, Konfiguration und Rust-Rechenmaßstab"},
    "provider": {
      "type": "object",
      "required": ["kind", "model", "safe_configuration_sha256", "cost_authorization"],
      "properties": {
        "kind": {"type": "string"},
        "model": {"type": "string"},
        "safe_configuration_sha256": {"$ref": "#/$defs/digest"},
        "cost_authorization": {"enum": ["subscription_first_luna", "explicit_paid_run_approval"]}
      },
      "additionalProperties": false,
      "description": "Erster Lauf ausschließlich bestehender codex_subscription mit gpt-6-luna. Geheimnisse nicht in Konfigurationsbeleg übernehmen."
    },
    "code_shas": {"type": "object", "required": ["brain", "discord", "twitch"], "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{40}$"}},
    "knowledge_binding": {"type": "object", "required": ["release_id", "knowledge_version", "release_bindings_sha256", "mirror_import_evidence_sha256"], "properties": {"release_id": {"type": "string"}, "knowledge_version": {"type": "string"}, "release_bindings_sha256": {"$ref": "#/$defs/digest"}, "mirror_import_evidence_sha256": {"$ref": "#/$defs/digest"}}, "additionalProperties": false},
    "live_prerequisite_evidence_sha256": {"$ref": "#/$defs/digest"},
    "samples": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/sample"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_count": {"type": ["integer", "null"], "minimum": 0},
    "usage": {
      "type": "object",
      "required": ["observed", "reserved", "unaccounted", "missing_reason"],
      "properties": {
        "observed": {"$ref": "#/$defs/token_values"},
        "reserved": {"$ref": "#/$defs/token_values"},
        "unaccounted": {"type": ["boolean", "null"]},
        "missing_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "token_values": {
      "type": "object", "required": ["input_tokens", "output_tokens", "network_rounds", "cost_micros"],
      "properties": {"input_tokens": {"$ref": "#/$defs/nullable_count"}, "output_tokens": {"$ref": "#/$defs/nullable_count"}, "network_rounds": {"$ref": "#/$defs/nullable_count"}, "cost_micros": {"$ref": "#/$defs/nullable_count"}},
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": ["case_id", "transport", "visibility", "message_events", "part_questions", "brain_question_reservations", "provider_calls", "delivered", "event_to_delivery_ms", "local_raw_evidence_sha256", "tool_calls", "numbers_match_rust", "citation_fidelity", "local_role_binding_verified", "foreign_private_message_reads", "usage"],
      "properties": {
        "case_id": {"type": "string"},
        "transport": {"enum": ["discord_mention", "discord_dm", "discord_thread", "twitch_chat"]},
        "visibility": {"enum": ["public", "private"]},
        "message_events": {"$ref": "#/$defs/nullable_count"},
        "part_questions": {"$ref": "#/$defs/nullable_count"},
        "brain_question_reservations": {"$ref": "#/$defs/nullable_count"},
        "provider_calls": {"$ref": "#/$defs/nullable_count"},
        "delivered": {"type": ["boolean", "null"]},
        "event_to_delivery_ms": {"type": ["number", "null"], "minimum": 0},
        "local_raw_evidence_sha256": {"$ref": "#/$defs/digest"},
        "tool_calls": {"type": ["array", "null"], "items": {"type": "object", "required": ["tool", "protected_arguments_sha256", "protected_result_sha256"], "properties": {"tool": {"type": "string"}, "protected_arguments_sha256": {"$ref": "#/$defs/digest"}, "protected_result_sha256": {"$ref": "#/$defs/digest"}}, "additionalProperties": false}},
        "numbers_match_rust": {"enum": ["pass", "fail", "not_applicable", "not_observed"]},
        "citation_fidelity": {"enum": ["pass", "fail", "not_observed"]},
        "local_role_binding_verified": {"type": ["boolean", "null"]},
        "foreign_private_message_reads": {"$ref": "#/$defs/nullable_count"},
        "usage": {"$ref": "#/$defs/usage"}
      },
      "additionalProperties": false,
      "description": "Werkzeugliste null bedeutet nicht erfasst. Leere Liste verlangt Beleg, dass kein Werkzeug aufgerufen wurde. Kein schematisch gültiger Lauf beweist fachliche Abnahme."
    }
  }
}
