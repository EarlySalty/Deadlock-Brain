# Optional overrides
DEADLOCK_BRAIN_DB_PATH=/home/naniadm/Documents/Deadlock-Brain/data/deadlock_brain.sqlite3
DEADLOCK_BRAIN_DATA_DIR=/home/naniadm/Documents/Deadlock-Brain/data

# Existing central bot DB used by the Patchnotes bot.
DEADLOCK_DB_PATH=/home/naniadm/Documents/Deadlock-Bots/data/deadlock.sqlite3

# Google Sheet source.
DEADLOCK_STATS_SHEET_ID=1fj9XMQmVUY0FY4cbozvB18PMBnpbdsaMFTZRLa74VRY
DEADLOCK_STATS_SHEET_GID=0

# Wiki is intentionally opt-in.
DEADLOCK_BRAIN_WIKI_ENABLED=0
DEADLOCK_BRAIN_WIKI_MIN_DELAY_SECONDS=5
DEADLOCK_BRAIN_WIKI_CACHE_TTL_SECONDS=604800

# MiniMax review generation. MINIMAX_TOKEN_PLAN_KEY uses the Anthropic-compatible
# token-plan endpoint, matching Deadlock-Bots.
MINIMAX_API_KEY=
# Alternative Infisical key name used by some bot environments.
MINIMAX_TOKEN_PLAN_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TOKEN_PLAN_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_SECONDS=300
# Technical API ceiling; runtime protection is handled by ANALYSIS_TIMEOUT_SECONDS in scripts.
MINIMAX_MAX_COMPLETION_TOKENS=16000
MINIMAX_TEMPERATURE=0.2
MINIMAX_TOP_P=0.9
