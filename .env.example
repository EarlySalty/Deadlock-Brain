# Nicht geheime Laufzeitoptionen. Die Anwendung lädt diese Datei nicht automatisch.
# Produktionssecrets werden über deadlock-brain-secret-exec aus Infisical in den Prozess gegeben.
DEADLOCK_BRAIN_DATA_DIR=/home/naniadm/Documents/Deadlock-Brain/data
DEADLOCK_BRAIN_ROOT=/home/naniadm/Documents/Deadlock-Brain

# Google Sheet Quelle.
DEADLOCK_STATS_SHEET_ID=1fj9XMQmVUY0FY4cbozvB18PMBnpbdsaMFTZRLa74VRY
DEADLOCK_STATS_SHEET_GID=0

# Wiki bleibt standardmäßig deaktiviert.
DEADLOCK_BRAIN_WIKI_ENABLED=0
DEADLOCK_BRAIN_WIKI_MIN_DELAY_SECONDS=5
DEADLOCK_BRAIN_WIKI_CACHE_TTL_SECONDS=604800

# Fireworks OpenAI kompatibler Provider. API Keys gehören in Infisical.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
FIREWORKS_TIMEOUT_SECONDS=300
FIREWORKS_MAX_TOKENS=16000
FIREWORKS_TEMPERATURE=0.2
FIREWORKS_TOP_P=0.9

# YouTube Caption Abruf.
YOUTUBE_CAPTION_TIMEOUT_SECONDS=30
